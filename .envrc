# Pi extensions - project-local storage
# Load this with: direnv allow

# pi-memory: store memories in project .pi folder
export PI_MEMORY_DIR="$PWD/.pi/memory"

# context-mode: store context/index in project .pi folder
# NOTE: the env var is CONTEXT_MODE_DATA_DIR (not CONTEXT_MODE_DIR).
# context-mode appends "context-mode/sessions" and "context-mode/content" to this root.
export CONTEXT_MODE_DATA_DIR="$PWD/.pi"
